{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "widgets/**/*.ts",
    "widgets/**/*.tsx",
    "admin-web/**/*.ts",
    "admin-web/**/*.tsx"
  ],
  "exclude": ["supabase/functions/**"]
}
