{
  "name": "pulse-2",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "doctor": "npx expo-doctor",
    "admin:web:build": "node scripts/build-admin-web.cjs",
    "admin:host:build": "node scripts/build-admin-worker.cjs",
    "android:apk": "bash scripts/build-android-local.sh apk",
    "android:aab": "bash scripts/build-android-local.sh aab",
    "legal:build": "node scripts/build-legal-worker.cjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.17",
    "@pdf-lib/fontkit": "1.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.117.1",
    "base64-arraybuffer": "1.0.2",
    "expo": "~58.0.10",
    "expo-asset": "~58.0.15",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.13",
    "expo-file-system": "~58.0.9",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.0",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.18",
    "expo-widgets": "~58.0.17",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.0-rc.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets"
        ]
      }
    }
  }
