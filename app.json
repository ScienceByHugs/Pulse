{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "pulse",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "28",
      "bundleIdentifier": "com.sciencebyhugs.pulse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/brand/pulse-icon.png"
    },
    "android": {
      "package": "com.sciencebyhugs.pulse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/pulse-adaptive-foreground.png",
        "backgroundColor": "#070F1E"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 4,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withWidgetBuildNumber",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Pulse to add your selected schedule entries to a calendar you choose. Pulse keeps event titles private by default."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pulse to use Face ID to protect your private protocol data."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PulseTodayWidget",
              "displayName": "Pulse Today",
              "description": "See how many Pulse items are due today without exposing medication names.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ],
                "initialLayout": "./widgets/PulseTodayWidget.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your private Pulse profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.sciencebyhugs.pulse.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.sciencebyhugs.pulse"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3bf7a227-b831-426f-a31c-768e22c620a9"
      }
    },
    "owner": "sciencebyhugss-team",
    "icon": "./assets/brand/pulse-icon.png",
    "androidStatusBar": {
      "backgroundColor": "#050A10",
      "barStyle": "light-content",
      "translucent": false
    }
  }
}
